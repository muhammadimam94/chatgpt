# Carbonio CE Docker Compose sample — development/testing only
CARBONIO_GLOBAL_IMAGES_TAG=main

# Set unique strong secrets locally. Do not commit the populated .env file.
LDAP_ROOT_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
LDAP_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
MARIADB_ROOT_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
# Keep this equal to POSTGRES_PASSWORD for this sample.
CARBONIO_POSTGRES_DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET

CARBONIO_GRAPHQL_API_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
EVENT_DISPATCHER_USER_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
XMPP_SERVER_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
VIDEO_SERVER_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET

# Optional public/NAT address used by the video server.
NAT_IP=
